// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String          @default("USER")

  accounts      Account[]
  sessions      Session[]
  authenticator Authenticator[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

enum StatusBMN {
  Aktif
  Tidak_Aktif @map("Tidak Aktif")
}

enum Kondisi {
  Baik
  Rusak_Ringan @map("Rusak Ringan")
  Rusak_Berat  @map("Rusak Berat")
  Dihapus
}

enum JenisRekomendasi {
  Pengadaan
  Penggantian
  Penghapusan
}

enum Prioritas {
  Tinggi
  Sedang
  Rendah
}

//
// MASTER TABLES
//

model Instansi {
  id            BigInt   @id @default(autoincrement())
  nama_instansi String
  alamat        String?
  telepon       String?
  email         String?
  website       String?
  logo          String?
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  @@map("instansis")
}

model Lokasi {
  id         BigInt    @id @default(autoincrement())
  kode_ruang String?
  nama_ruang String
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")
  barangs    Barang[]

  @@unique([nama_ruang])
  @@map("lokasis")
}

model Pegawai {
  id        BigInt    @id @default(autoincrement())
  nip       String?   @unique
  nama      String
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")
  barangs   Barang[]

  @@map("pegawais")
}

//
// TRANSACTION TABLES
//

model Barang {
  id            BigInt   @id @default(autoincrement())
  kode_barang   String
  nup           String
  nama_barang   String
  merk          String?
  kode_register String?
  status_bmn    StatusBMN @default(Aktif)
  lokasi_id     BigInt?
  pegawai_id    BigInt?
  kondisi       Kondisi   @default(Baik)
  createdAt     DateTime? @map("created_at")
  updatedAt     DateTime? @map("updated_at")

  lokasi        Lokasi?   @relation(fields: [lokasi_id], references: [id], onDelete: SetNull)
  pegawai       Pegawai?  @relation(fields: [pegawai_id], references: [id], onDelete: SetNull)

  maintenances  Maintenance[]
  usulans       Usulan[]

  @@unique([kode_barang, nup])
  @@map("barangs")
}

model Maintenance {
  id              BigInt   @id @default(autoincrement())
  barang_id       BigInt
  tanggal         DateTime @db.Date
  jenis           String
  deskripsi       String?
  biaya           Int?
  kondisi_setelah Kondisi
  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  barang          Barang   @relation(fields: [barang_id], references: [id], onDelete: Cascade)

  @@map("maintenances")
}

model Usulan {
  id                BigInt            @id @default(autoincrement())
  barang_id         BigInt
  jenis_rekomendasi JenisRekomendasi
  alasan            String
  prioritas         Prioritas
  tahun             Int
  createdAt         DateTime? @map("created_at")
  updatedAt         DateTime? @map("updated_at")

  barang            Barang @relation(fields: [barang_id], references: [id], onDelete: Cascade)

  
  @@map("usulans")
}